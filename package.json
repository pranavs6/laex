{
  "name": "laex",
  "version": "0.1.0",
  "private": true,
  "description": "Local LaTeX editor: source, terminal and live PDF side by side",
  "type": "module",
  "bin": {
    "laex": "bin/laex"
  },
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=esm --target=es2022 --minify --sourcemap --outdir=public/build --loader:.ttf=file && cp node_modules/pdfjs-dist/build/pdf.worker.min.mjs public/build/",
    "start": "node server.js",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null; npm run build"
  },
  "license": "MIT",
  "dependencies": {
    "node-pty": "^1.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "^5.6.205"
  }
}
